DEFAULT_MODEL_DIR = "/mnt/raid0/jjy/CosyVoice/pretrained_models/CosyVoice2-0.5B"
DEFAULT_PROMPT_WAV = "/mnt/raid0/jjy/CosyVoice/asset/zero_shot_prompt.wav"
